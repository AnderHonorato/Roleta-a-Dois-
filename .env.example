# ---------------------------------------------------------------
# Roleta a Dois - variaveis de ambiente
# Copie para .env e ajuste. NUNCA comite o .env real.
# ---------------------------------------------------------------

# Modo demo local: roda 100% no navegador, sem servidor e sem banco.
# true  -> usa LocalStorageAdapter, casal mockado, sem rede.
# false -> exige VITE_API_URL e um backend compativel (ver docs/ARCHITECTURE.md).
VITE_MODO_DEMO_LOCAL=true

# Nome exibido do produto (branding)
VITE_APP_NAME=Roleta a Dois

# URL base da API (ignorada quando VITE_MODO_DEMO_LOCAL=true)
VITE_API_URL=

# Tamanho maximo de upload de imagem em MB (avatar / banner)
VITE_MAX_UPLOAD_MB=4

# ---------------------------------------------------------------
# Apenas backend (NUNCA prefixe com VITE_ - VITE_ vaza para o bundle)
# ---------------------------------------------------------------
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/roleta
# SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio
# PASSWORD_PEPPER=
